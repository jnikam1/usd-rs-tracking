# Phone push via ntfy.sh (free, no account). Install the ntfy app and subscribe to this topic.
NTFY_TOPIC=
# Alert when the mid market rate is at or above / at or below these levels (rupees per dollar)
ALERT_ABOVE=95
ALERT_BELOW=93.5
# Alert when the rate moves this much (percent) in 24 hours
ALERT_MOVE_PCT=0.5
# Send amount (USD) used for the "best app" line in alerts
ALERT_AMOUNT=1000
# Optional: if set, /api/cron/check requires Authorization: Bearer <CRON_SECRET> or ?key=<CRON_SECRET>
CRON_SECRET=
