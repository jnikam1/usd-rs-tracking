# ---- Provider data ----
# Wise documents its Comparison API as requiring authentication. Set a Wise API token (personal or
# client credentials) to use the supported integration. The token stays on the server.
WISE_API_TOKEN=
# Opt in to unauthenticated access instead. It works today but is undocumented and may stop at any time;
# rows are labelled accordingly. Leave empty to show only Wise's own quote and the research models.
WISE_COMPARISON_PUBLIC=
# WISE_API_BASE=https://api.wise.com
# WISE_API_VERSION=2026Q4

# ---- Freshness rules (defaults shown) ----
# MID_FRESH_MINUTES=30
# MID_MAX_AGE_HOURS=72
# COMPARISON_FRESH_HOURS=6
# COMPARISON_MAX_AGE_HOURS=72
# PROVIDER_QUOTE_MAX_AGE_HOURS=6
# SNAPSHOT_MAX_AGE_DAYS=45

# ---- Server alerts ----
# Required in production: callers must send Authorization: Bearer <CRON_SECRET>. Without it the check refuses to run.
CRON_SECRET=
# ntfy.sh topic to post to. Pick something hard to guess.
NTFY_TOPIC=
ALERT_ABOVE=
ALERT_BELOW=
ALERT_MOVE_PCT=0.5
ALERT_AMOUNT=1000
# Link opened when a notification is tapped
APP_URL=

# Local only: offline demo data (ignored in Vercel production)
# MOCK_FX=1
